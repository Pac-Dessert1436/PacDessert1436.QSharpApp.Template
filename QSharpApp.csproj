<Project Sdk="Microsoft.Quantum.Sdk/0.28.302812">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>QSharpApp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PacDessert1436.QSharpApp.Template</PackageId>
    <Version>1.0.10</Version>
    <Title>Q# Console App Template</Title>
    <Authors>Pac-Dessert1436</Authors>
    <PackageType>Template</PackageType>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="AppMain.qs" Pack="true" PackagePath="content\" />
    <None Include=".template.config\**\*" Pack="true" PackagePath="content\.template.config\" />
    <None Include="README.md" Pack="true" PackagePath="content\README.md" />
  </ItemGroup>
</Project>
